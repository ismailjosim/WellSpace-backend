{
  "name": "wellspace",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec tsx watch ./src/server.ts",
    "dev:node": "pnpm exec ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node ./dist/server.js",
    "postinstall": "prisma generate",
    "prisma:migrate": "pnpm exec prisma migrate dev",
    "prisma:generate": "pnpm exec prisma generate",
    "lint": "eslint",
    "format": "prettier --write '**/*.{ts,tsx,json}'"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "eslint": "^10.4.1",
    "prettier": "^3.8.4",
    "prisma": "^7.7.0",
    "stripe": "^19.1.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.61.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
