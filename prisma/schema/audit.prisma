model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  userRole     String?
  action       String
  resourceType String
  resourceId   String
  oldData      Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

